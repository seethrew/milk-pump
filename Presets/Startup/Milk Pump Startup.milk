MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fRating=5.00000
fGammaAdj=1.00000
fDecay=1.00000
fVideoEchoZoom=1.00000
fVideoEchoAlpha=0.00000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.00000
fWaveScale=1.00000
fWaveSmoothing=0.00000
fWaveParam=0.00000
fModWaveAlphaStart=0.75000
fModWaveAlphaEnd=0.95000
fWarpAnimSpeed=1.00000
fWarpScale=1.00000
fZoomExponent=1.00000
fShader=0.00000
zoom=1.00000
rot=0.00000
cx=0.50000
cy=0.50000
dx=0.00000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=1.00000
wave_g=1.00000
wave_b=1.00000
wave_x=0.50000
wave_y=0.50000
ob_size=0.00000
ob_r=0.00000
ob_g=0.00000
ob_b=0.00000
ob_a=0.00000
ib_size=0.00000
ib_r=0.00000
ib_g=0.00000
ib_b=0.00000
ib_a=0.00000
nMotionVectorsX=0.00000
nMotionVectorsY=0.00000
mv_dx=0.00000
mv_dy=0.00000
mv_l=0.00000
mv_r=0.00000
mv_g=0.00000
mv_b=0.00000
mv_a=0.00000
per_frame_init_1=tq = 0; kick = 0;
per_frame_1=// Milk Pump's opening screen (Daxy & Claude, 2026): the name pours in, holds, melts into drips
per_frame_2=// that run faster on the kick, and pours again every 8 s. Logo: Presets\Textures\milkpump.png.
per_frame_3=tq = tq + 1/max(fps, 10);
per_frame_4=ph = tq - int(tq/8)*8;
per_frame_5=kick = max(kick*0.85, min(1, max(0, bass - 1.1)));
per_frame_6=q1 = min(1, max(0, bass_att - 0.9));
per_frame_7=q2 = below(ph, 4)*min(1, ph/0.8);
per_frame_8=q3 = min(1, ph/0.8)*(1 - min(1, max(0, (ph - 4)/2.5)));
per_frame_9=q4 = kick;
warp_1=`sampler sampler_pc_milkpump;
warp_2=`shader_body
warp_3=`{
warp_4=`    // Each column of milk runs down at its own speed (most barely move, a few drip), faster on a kick.
warp_5=`    float n = tex2D(sampler_noise_lq, float2(uv.x*1.1, 0.37)).x;
warp_6=`    float d = smoothstep(0.5, 0.85, n);
warp_7=`    float fall = (0.0003 + 0.0055*d)*(1 + 2.5*q4);
warp_8=`    float2 p = uv - float2(0, fall);
warp_9=`    float3 c = tex2D(sampler_fc_main, p).xyz;   // clamped: drips leave at the bottom, never wrap to the top
warp_10=`    c = max(c, tex2D(sampler_fc_main, p + float2(texsize.z, 0)).xyz*0.97);
warp_11=`    c = max(c, tex2D(sampler_fc_main, p - float2(texsize.z, 0)).xyz*0.97);
warp_12=`    c *= lerp(0.93, 0.993, d);
warp_13=`
warp_14=`    // The logo keeps pouring in while it is up, so the drips leave from the letters' feet.
warp_15=`    float w = 0.62*(1 + 0.05*q1);
warp_16=`    float2 lp = uv - 0.5;
warp_17=`    lp.x /= w;
warp_18=`    lp.y /= w*0.25*texsize.x*texsize.w;
warp_19=`    lp += 0.5;
warp_20=`    float inside = step(0, lp.x)*step(lp.x, 1)*step(0, lp.y)*step(lp.y, 1);
warp_21=`    float l = tex2D(sampler_pc_milkpump, lp).x*inside*q2;
warp_22=`    ret = max(c, l*float3(0.95, 0.94, 0.9));
warp_23=`}
comp_1=`sampler sampler_pc_milkpump;
comp_2=`shader_body
comp_3=`{
comp_4=`    float3 c = tex2D(sampler_main, uv).xyz;
comp_5=`    c += GetBlur1(uv)*0.3;
comp_6=`
comp_7=`    // The crisp letters on top, swelling a touch with the bass.
comp_8=`    float w = 0.62*(1 + 0.05*q1);
comp_9=`    float2 lp = uv - 0.5;
comp_10=`    lp.x /= w;
comp_11=`    lp.y /= w*0.25*texsize.x*texsize.w;
comp_12=`    lp += 0.5;
comp_13=`    float inside = step(0, lp.x)*step(lp.x, 1)*step(0, lp.y)*step(lp.y, 1);
comp_14=`    float l = tex2D(sampler_pc_milkpump, lp).x*inside*q3;
comp_15=`    ret = max(c*float3(1, 0.98, 0.93), l);
comp_16=`}
