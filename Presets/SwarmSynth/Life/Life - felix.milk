MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fRating=4.00000
fGammaAdj=1.00000
fDecay=1.00000
fVideoEchoZoom=1.00000
fVideoEchoAlpha=0.00000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.00000
fWaveScale=1.00000
fWaveSmoothing=0.00000
fWaveParam=0.00000
fModWaveAlphaStart=0.75000
fModWaveAlphaEnd=0.95000
fWarpAnimSpeed=1.00000
fWarpScale=1.00000
fZoomExponent=1.00000
fShader=0.00000
zoom=1.00000
rot=0.00000
cx=0.50000
cy=0.50000
dx=0.00000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=1.00000
wave_g=1.00000
wave_b=1.00000
wave_x=0.50000
wave_y=0.50000
ob_size=0.00000
ob_r=0.00000
ob_g=0.00000
ob_b=0.00000
ob_a=0.00000
ib_size=0.00000
ib_r=0.00000
ib_g=0.00000
ib_b=0.00000
ib_a=0.00000
nMotionVectorsX=0.00000
nMotionVectorsY=0.00000
mv_dx=0.00000
mv_dy=0.00000
mv_l=0.00000
mv_r=0.00000
mv_g=0.00000
mv_b=0.00000
mv_a=0.00000
per_frame_init_1=t0 = time;
per_frame_init_2=laststep = -1;
per_frame_init_3=pending = 0;
per_frame_init_4=lasthit = 0;
per_frame_init_5=lastt = time;
per_frame_init_6=q8 = 16;
per_frame_init_7=q9 = 16;
per_frame_1=el = time - t0;
per_frame_2=st = int(el/0.500000);
per_frame_3=q3 = above(st, laststep);
per_frame_4=laststep = st;
per_frame_5=q1 = q3*equal(st % 1, 0);
per_frame_6=q10 = st % 32;
per_frame_7=q13 = 1;
per_frame_8=q2 = below(el, 2.8);
per_frame_9=q4 = 8;
per_frame_10=q5 = 12;
per_frame_11=beat = above(bass, 1.3)*above(bass, bass_att*1.15)*above(time - lasthit, 0.25);
per_frame_12=lasthit = if(beat, time, lasthit);
per_frame_13=pending = max(pending, beat);
per_frame_14=q7 = q1*pending*(1 - q2);
per_frame_15=pending = pending*(1 - q1);
per_frame_16=q8 = if(beat, rand(32), q8);
per_frame_17=q9 = if(beat, rand(32), q9);
per_frame_18=q12 = 3;
per_frame_19=q6 = 0.350;
per_frame_20=q11 = if(q2, q11, if(beat, rand(1000)/1000, q11));
per_frame_21=q11 = if(below(el, 0.05), rand(1000)/1000, q11);
warp_1=`sampler sampler_pc_life_felix;
warp_2=`shader_body
warp_3=`{
warp_4=`    // The grid lives in this picture, each cell a block of pixels: red alive, green age, blue flash.
warp_5=`    float2 cell = 1.0/32.0;
warp_6=`    float2 cid = floor(uv*32);
warp_7=`    float2 c = (cid + 0.5)*cell;
warp_8=`    float3 me = tex2D(sampler_pw_main, c).xyz;
warp_9=`    float n = 0;   // live neighbours; the wrapping sampler makes the grid a torus
warp_10=`    n += step(0.5, tex2D(sampler_pw_main, c + cell*float2(-1,-1)).x);
warp_11=`    n += step(0.5, tex2D(sampler_pw_main, c + cell*float2( 0,-1)).x);
warp_12=`    n += step(0.5, tex2D(sampler_pw_main, c + cell*float2( 1,-1)).x);
warp_13=`    n += step(0.5, tex2D(sampler_pw_main, c + cell*float2(-1, 0)).x);
warp_14=`    n += step(0.5, tex2D(sampler_pw_main, c + cell*float2( 1, 0)).x);
warp_15=`    n += step(0.5, tex2D(sampler_pw_main, c + cell*float2(-1, 1)).x);
warp_16=`    n += step(0.5, tex2D(sampler_pw_main, c + cell*float2( 0, 1)).x);
warp_17=`    n += step(0.5, tex2D(sampler_pw_main, c + cell*float2( 1, 1)).x);
warp_18=`    float alive = step(0.5, me.x);
warp_19=`    // The rule: bit n of q4 (birth) or q5 (survive).
warp_20=`    float next = lerp(fmod(floor(q4/exp2(n)), 2), fmod(floor(q5/exp2(n)), 2), alive);
warp_21=`    // A beat stirs a square patch (centre q8,q9, half-size q12) with random cells (density q6).
warp_22=`    float2 d = abs(cid - float2(q8, q9));
warp_23=`    d = min(d, 32 - d);
warp_24=`    float soup = step(1 - q6, tex2D(sampler_noise_lq, (cid + 0.5)/256.0 + q11).x);
warp_25=`    next = lerp(next, soup, q7*step(max(d.x, d.y), q12));
warp_26=`    float now = lerp(alive, next, q1);          // q1: a generation this frame
warp_27=`    float born = q1*now*(1 - alive);
warp_28=`    float age = lerp(me.y, born > 0.5 ? 1.0 : (now > 0.5 ? max(me.y*0.8, 0.22) : me.y*0.5), q1);
warp_29=`    float sensor = step(0.5, tex2D(sampler_pc_life_felix, c).y);
warp_30=`    // Flashes: a cell born on a sensor, and live cells the playhead plays (q3: a step, q13 shown).
warp_31=`    float played = q3*q13*step(abs(cid.x - q10), 0.5)*now;
warp_32=`    float flash = max(me.z*0.88, max(born*sensor, played));
warp_33=`    // The start (q2): the patch's picture, or a random soup.
warp_34=`    float start = step(0.5, tex2D(sampler_pc_life_felix, c).x);
warp_35=`    now = lerp(now, start, q2);
warp_36=`    age = lerp(age, start, q2);
warp_37=`    flash = flash*(1 - q2);
warp_38=`    ret = float3(now, age, flash);
warp_39=`}
comp_1=`sampler sampler_pc_life_felix;
comp_2=`shader_body
comp_3=`{
comp_4=`    // A square grid in the middle of the screen.
comp_5=`    float2 sq = texsize.xy/min(texsize.x, texsize.y);
comp_6=`    float2 g = (uv - 0.5)*sq/0.92 + 0.5;
comp_7=`    float inside = step(0, g.x)*step(g.x, 1)*step(0, g.y)*step(g.y, 1);
comp_8=`    float2 cid = floor(g*32);
comp_9=`    float2 f = frac(g*32) - 0.5;
comp_10=`    float3 s = tex2D(sampler_pw_main, (cid + 0.5)/32).xyz;
comp_11=`    float edge = max(abs(f.x), abs(f.y));
comp_12=`    float box = smoothstep(0.45, 0.38, edge);
comp_13=`    float ring = box - smoothstep(0.33, 0.27, edge);
comp_14=`    float alive = step(0.5, s.x);
comp_15=`    // Brightness carries the story (newborn brightest, old dimmer, the dead fading out), so it
comp_16=`    // reads without colour.
comp_17=`    float lum = alive*(0.5 + 0.5*s.y) + (1 - alive)*s.y*0.28;
comp_18=`    float3 milk = float3(1.0, 0.97, 0.9);
comp_19=`    float3 tint = (0.55 + 0.45*cos(6.2831853*(0.578 + float3(0, 0.33, 0.67))));
comp_20=`    float glow = GetBlur1(saturate(g)).x*inside;
comp_21=`    float3 col = box*lum*lerp(milk, tint, 0.35*(1 - s.y)) + glow*0.35*tint;
comp_22=`    col += ring*0.07*inside;                                        // the empty grid, faintly
comp_23=`    float sensor = tex2D(sampler_pc_life_felix, (cid + 0.5)/32).y;
comp_24=`    col += sensor*(ring*0.22 + box*0.03)*inside;                   // sensors: outlined squares
comp_25=`    col += box*s.z*float3(1, 1, 0.8);                               // flashes
comp_26=`    col += q13*inside*step(abs(cid.x - q10), 0.5)*0.12;            // the playhead
comp_27=`
comp_28=`    ret = col*inside;
comp_29=`}
